[gd_scene load_steps=2 format=3 uid="uid://c_entity_ui"]

[ext_resource type="Script" path="res://scenes/battle/components/entity_ui.gd" id="1_entity_ui"]

[node name="EntityUI" type="Control"]
custom_minimum_size = Vector2(140, 190)
layout_mode = 3
anchors_preset = 0
